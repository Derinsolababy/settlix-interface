# Every value has a working testnet default (see src/lib/config.ts), so
# `npm run dev` works without a .env file. Override for other deployments.

NEXT_PUBLIC_STELLAR_NETWORK=testnet
NEXT_PUBLIC_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# settlix-oracle, for USD pricing in the merchant console.
NEXT_PUBLIC_ORACLE_URL=http://localhost:3001

